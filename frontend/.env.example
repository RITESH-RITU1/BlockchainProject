# ==============================================================================
# ClearEscrow Environment Configuration Template
# Copy this file to .env.local and populate the secrets as needed.
# NEVER commit .env.local or real private keys/passwords to version control.
# ==============================================================================

# Web Push VAPID Keys (Generate with `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"
VAPID_SUBJECT="mailto:admin@clearescrow.local"

# Authentication HMAC Secret for Session Signatures (Any random 32-byte secret string)
AUTH_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_SECRET"

# Arbitrum Sepolia RPC URL & Contract Address
NEXT_PUBLIC_RPC_URL="https://sepolia-rollup.arbitrum.io/rpc"
NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS="0xAbc85afeC52cf3C8371e54dB11Fe28129DE9F824"
